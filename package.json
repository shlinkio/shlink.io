{
  "name": "shlink-website",
  "description": "Shlink project website",
  "author": "Alejandro Celaya Alastrué",
  "readmeFilename": "README.md",
  "private": false,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/shlinkio/shlink.io"
  },
  "scripts": {
    "cs": "node --run lint && node --run format:check",
    "cs:fix": "node --run lint:fix && node --run format",
    "lint": "oxlint src scripts ./*.config.ts",
    "lint:fix": "node --run lint -- --fix",
    "format": "oxfmt src scripts ./*.config.ts",
    "format:check": "node --run format -- --check",
    "types": "tsc",
    "purge": "node scripts/purgecss.js",
    "dev": "astro dev --ignore-lock --host=0.0.0.0",
    "build": "astro build",
    "build:prod": "node --run build && node --run purge",
    "preview": "astro preview --host=0.0.0.0"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@docsearch/react": "^4.7.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@mdx-js/react": "^3.1.1",
    "astro": "^7.2.7",
    "astro-expressive-code": "^0.44.1",
    "astro-seo": "^1.1.0",
    "bootstrap": "^5.3.8",
    "clsx": "^2.1.1",
    "mdx-mermaid": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-external-link": "^2.7.0",
    "typed.js": "^3.0.0"
  },
  "devDependencies": {
    "@shlinkio/eslint-config-js-coding-standard": "~4.1.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/trusted-types": "^2.0.7",
    "eslint-plugin-astro": "^3.1.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "purgecss": "^8.0.0",
    "sass": "^1.102.0",
    "typescript": "^7.0.2"
  }
}
